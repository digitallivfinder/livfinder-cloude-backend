# ---------------------------------------------------------------------------
# LivFinder API — environment
# Copy to .env and adjust. Nothing here is a real secret.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------------------
# Matches the variable names used by db/tools/load.sh so one .env can drive both.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=livfinder
# Set DB_SOCKET instead of host/port to connect over a unix socket.
DB_SOCKET=
DB_CONNECTION_LIMIT=15
DB_CONNECT_TIMEOUT_MS=10000

# --- HTTP -----------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Comma-separated. Browsers treat localhost and 127.0.0.1 as different origins, so list every
# spelling the site is actually opened on. Outside production any loopback origin is accepted
# regardless; in production only what is listed here is.
LIVFINDER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BODY_LIMIT=1mb
TRUST_PROXY=false

# --- Sessions -------------------------------------------------------------
# SESSION_SECRET signs nothing on its own: sessions are server-side rows in
# user_sessions and the cookie carries an opaque random token. The secret is
# used for the CSRF token HMAC and must be at least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_NAME=livfinder_session
SESSION_TTL_DAYS=30
CSRF_COOKIE_NAME=livfinder_csrf
# Cookies are marked Secure automatically when NODE_ENV=production.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# --- Storage --------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
# Public base URL the API advertises for locally-stored public media.
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/media

# Seeded catalogue imagery points at this CDN host. Leave MEDIA_CDN_BASE_URL empty and the API
# serves a generated stand-in for those paths, so nothing renders as a broken image locally; set
# it to a real origin and the URLs are rewritten there instead.
MEDIA_LEGACY_CDN_HOST=cdn.livfinder.com
MEDIA_CDN_BASE_URL=

# S3 / S3-compatible. Leave blank to stay on the local driver.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# --- Mail -----------------------------------------------------------------
# log | smtp. "log" prints each email in the terminal, saves it to storage/mailbox and, outside
# production, shows it at <API origin>/dev/mailbox. Nothing is actually sent.
MAIL_DRIVER=log
MAIL_FROM=no-reply@livfinder.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Payments -------------------------------------------------------------
# mock | stripe
PAYMENTS_DRIVER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Misc -----------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PUBLIC_SITE_ORIGIN=https://livfinder.com

# --- Social sign-in ---------------------------------------------------------
# A provider appears on the login screens once its client id and secret are both set. Register
# <API origin>/v1/auth/oauth/<provider>/callback as the redirect URI with the provider.
# Google and LinkedIn need nothing else. Any other provider also needs
# OAUTH_<PROVIDER>_AUTHORIZE_URL, _TOKEN_URL and _USERINFO_URL.
# The same Google client connects calendars: enable the Google Calendar API on its project, add the
# calendar.events scope and register <API origin>/v1/portal/calendar/google/callback as well.
# OUTBOUND_ALLOWED_HOSTS, when set, must include googleapis.com.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=

# --- Security ---------------------------------------------------------------
# Hosts the API may make outbound requests to (OAuth token and userinfo endpoints). Empty means
# any public address; private and link-local ranges are refused either way, so the cloud
# metadata endpoint cannot be reached. See src/utils/safeFetch.js.
OUTBOUND_ALLOWED_HOSTS=

# Upload scanning. "none" records `skipped` — honest about doing nothing, and a different claim
# from `clean`. "clamav" scans through clamd. "reject" additionally refuses an upload the
# scanner could not check. See src/modules/media/scanner.js.
MALWARE_SCAN_DRIVER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# --- Public API cache (Redis) ---------------------------------------------------
# Leave REDIS_URL empty to run without a cache. With it set and Redis down, the API still
# serves every request from MySQL. Locally: brew install redis && brew services start redis
REDIS_URL=redis://127.0.0.1:6379
CACHE_PREFIX=lf
CACHE_PUBLIC_TTL_SECONDS=300
CACHE_STALE_SECONDS=600
