# Liv Finder — database connection
#
# Copy to .env and adjust. tools/load.sh and the Makefile read these from the
# environment; .env is gitignored.

# A local server: leave DB_HOST as localhost and the loader connects over the
# unix socket, which is what a root account using the unix_socket auth plugin
# (the Debian/Ubuntu default) requires. Passing an explicit host and port would
# force TCP and be denied.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=livfinder

# Set DB_SOCKET only if the socket is not where your client expects it:
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# A remote server, or the docker-compose.yml in this directory. Any DB_HOST other
# than "localhost" makes the loader connect over TCP.
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=root
# DB_PASSWORD=root
